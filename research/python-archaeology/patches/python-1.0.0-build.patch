diff --git a/Parser/fgetsintr.c b/Parser/fgetsintr.c
new file mode 100644
index 0000000..335b890
--- /dev/null
+++ b/Parser/fgetsintr.c
@@ -0,0 +1,21 @@
+/* Reconstructed 2026: fgets that reports interrupts via errcode.h values */
+#include <stdio.h>
+#include <errno.h>
+#include "PROTO.h"
+#include "errcode.h"
+#include "intrcheck.h"
+int
+fgets_intr(char *buf, int size, FILE *fp)
+{
+	if (intrcheck())
+		return E_INTR;
+	errno = 0;
+	if (fgets(buf, size, fp) == NULL) {
+		if (intrcheck() || errno == EINTR) {
+			clearerr(fp);
+			return E_INTR;
+		}
+		return E_EOF;
+	}
+	return E_OK;
+}
