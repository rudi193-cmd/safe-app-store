{
  "app_id": "safe-app-genealogy",
  "name": "genealogy",
  "version": "1.0.0",
  "safe_version": ">=2.0.0",
  "b17": "EC768",
  "agent_type": "tool",
  "description": "The Aionic Genealogy Project — family tree research with FamilySearch API, Find a Grave, and Paperclip DB cross-reference.",
  "author": "Sean Campbell",
  "data_streams": [
    {
      "id": "familysearch_queries",
      "purpose": "Genealogy API lookups",
      "retention": "session",
      "description": "FamilySearch API calls"
    },
    {
      "id": "network_requests",
      "purpose": "Network data fetching",
      "retention": "session",
      "description": "Outbound network requests"
    },
    {
      "id": "file_writes",
      "purpose": "File system writes",
      "retention": "permanent",
      "description": "Files written by app"
    }
  ],
  "permissions": [
    "network_fetch",
    "file_write"
  ],
  "privacy_tier": "client_only",
  "local_processing": 0.96,
  "port": 8425,
  "entry_point": "safe_integration:status",
  "license": "MIT",
  "repository": "https://github.com/rudi193-cmd/safe-app-genealogy"
}
