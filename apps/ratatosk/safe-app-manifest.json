{
  "app_id": "ratatosk",
  "name": "Ratatosk",
  "version": "1.2.0",
  "safe_version": ">=2.0.0",
  "b17": "L3178",
  "agent_type": "tool",
  "description": "Willow platform session runtime — MCP client, capability gate, JSONL sessions, Grove bus, tier-0 deposit sync.",
  "author": "sean",
  "data_streams": [
    {
      "id": "sessions",
      "purpose": "JSONL session logs under $WILLOW_HOME/ratatosk/sessions/",
      "retention": "permanent",
      "description": "Session transcripts stored locally."
    },
    {
      "id": "deposits",
      "purpose": "Tier-0 sync deposit bundles under $WILLOW_HOME/ratatosk/sync-out/",
      "retention": "permanent",
      "description": "Exported when --deposit is passed."
    },
    {
      "id": "grove_events",
      "purpose": "Session start/end on Grove bus via MCP",
      "retention": "permanent",
      "description": "Requires RATATOSK_GROVE_CHANNEL and --mcp."
    }
  ],
  "permissions": [
    "local_llm",
    "filesystem_write"
  ],
  "privacy_tier": "local",
  "local_processing": 1.0,
  "entry_point": "ratatosk.crown:main",
  "license": "MIT",
  "repository": "https://github.com/willow-memory/ratatosk",
  "notes": "Playground launcher depends on willow-ratatosk (PyPI). MCP via willow-mcp (RATATOSK_MCP_COMMAND). Grove via grove_send_message when --mcp."
}
