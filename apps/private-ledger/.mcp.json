{
  "mcpServers": {
    "willow": {
      "type": "stdio",
      "command": "${WILLOW_MCP_PYTHON:-python3}",
      "args": ["-m", "willow_mcp"],
      "env": {
        "WILLOW_APP_ID": "private-ledger",
        "WILLOW_AGENT_NAME": "private-ledger",
        "GROVE_SENDER": "private-ledger",
        "GROVE_NAME": "private-ledger",
        "WILLOW_PG_DB": "willow_20"
      }
    }
  }
}
