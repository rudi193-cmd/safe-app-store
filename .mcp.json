{
  "mcpServers": {
    "willow": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "/home/sean-campbell/github/willow-2.0/sap/unified_mcp.sh"
      ],
      "env": {
        "WILLOW_AGENT_NAME": "vishwakarma",
        "GROVE_SENDER": "vishwakarma",
        "GROVE_NAME": "vishwakarma",
        "WILLOW_GROVE_ROOT": "/home/sean-campbell/github/safe-app-willow-grove",
        "WILLOW_PG_DB": "willow_20",
        "WILLOW_SAFE_ROOT": "/home/sean-campbell/github/SAFE/Applications",
        "WILLOW_AGENTS_ROOT": "/home/sean-campbell/github/SAFE/Agents",
        "WILLOW_ROOT": "/home/sean-campbell/github/willow-2.0",
        "WILLOW_HOME": "/home/sean-campbell/github/.willow",
        "WILLOW_CONFIG_MODE": "private-config",
        "WILLOW_INFERENCE_PROVIDER": "auto",
        "WILLOW_MCP_PROFILE": "standard",
        "WILLOW_DEV_SAFE_ROOT": "/home/sean-campbell/github",
        "WILLOW_STORE_ROOT": "/home/sean-campbell/github/safe-app-store-public/.willow/store"
      }
    },
    "nestor": {
      "type": "stdio",
      "command": "nestor",
      "args": [
        "serve",
        "--db", "${HOME}/github/safe-app-store-public/stores/decisions/.nestor/vault.db",
        "--source-lang", "decision",
        "--target-lang", "decision"
      ],
      "env": {
        "NESTOR_LEDGER": "${HOME}/github/safe-app-store-public/stores/decisions/.nestor/ledger.jsonl"
      }
    },
    "law-gazelle": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${HOME}/github/safe-app-store-public/apps/law-gazelle/gazelle_mcp.py"
      ],
      "env": {
        "NEST_SOURCE": "/home/sean-campbell/Desktop/Nest",
        "PYTHONPATH": "/home/sean-campbell/github/safe-app-store-public/apps/law-gazelle"
      }
    },
    "courtlistener": {
      "type": "stdio",
      "command": "${HOME}/github/willow-2.0/.venv-dev/bin/python3",
      "args": [
        "${HOME}/github/courtlistener-mcp/src/server.py"
      ],
      "env": {
        "PYTHONPATH": "/home/sean-campbell/github/courtlistener-mcp/src"
      }
    }
  }
}
